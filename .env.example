# ==============================================================
# NEXARION — Environment Configuration
# ==============================================================
# Copy this file to .env and fill in your values.
#
# LOCAL DEVELOPMENT:  cp .env.example .env
# RENDER / VERCEL:    Set these as environment variables in the dashboard.
# ==============================================================

# --- Core Application ---
APP_NAME=nexarion
LOG_LEVEL=INFO
DEBUG=false
PORT=8000
SESSION_SECRET=your_jwt_session_secret_change_in_production

# --- URLs ---
# Local dev: http://localhost:5173 | Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Database ---
# Local:  postgresql+psycopg://postgres:your_password@localhost:5432/nexarion_db
# Neon:   postgresql+psycopg://user:pass@ep-xxx.us-east-2.aws.neon.tech/nexarion_db?sslmode=require
# Render: Use the Internal Database URL from your Render PostgreSQL dashboard
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/nexarion_db

# --- AI / LLM Provider ---
# Options: "ollama" (local, requires GPU/CPU) or "nvidia" (cloud API, no GPU needed)
# For free cloud deployment, use "nvidia" with a free NVIDIA NIM API key.
LLM_PROVIDER=ollama

# Ollama (local inference — do NOT use on Render/Railway free tier)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# NVIDIA NIM (cloud inference — works on any free tier)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

LLM_TIMEOUT_SECONDS=60.0
LLM_FILE_CONCURRENCY=2
LLM_TEMPERATURE=0.1

# --- Cloudinary (avatar uploads, optional) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- GitHub Integration (optional) ---
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
